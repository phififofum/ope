{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poggywoggy.dev/schemas/board_game.schema.json",
  "title": "Board game",
  "description": "A title the shop lends, sells, or both. The component list is the point: every returned copy is checked against it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "name",
    "player_count",
    "play_minutes",
    "weight",
    "retail_price",
    "components"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+$"
    },
    "type": {
      "const": "board_game"
    },
    "name": {
      "type": "string",
      "pattern": "^loc:[a-z0-9_.]+$"
    },
    "designer": {
      "type": "string"
    },
    "player_count": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "play_minutes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "weight": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Complexity, 1 filler to 5 heavy."
    },
    "teach_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "retail_price": {
      "type": "number",
      "minimum": 0
    },
    "library_eligible": {
      "type": "boolean"
    },
    "shelf_footprint": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "count"
        ],
        "properties": {
          "part": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "loss_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How readily this part goes missing. Small wooden cubes: high."
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
