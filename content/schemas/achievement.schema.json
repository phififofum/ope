{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poggywoggy.dev/schemas/achievement.schema.json",
  "title": "Achievement",
  "description": "Something worth having done. Named for the moment rather than the metric where possible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "name",
    "description",
    "condition"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+$"
    },
    "type": {
      "const": "achievement"
    },
    "name": {
      "type": "string",
      "pattern": "^loc:[a-z0-9_.]+$"
    },
    "description": {
      "type": "string",
      "pattern": "^loc:[a-z0-9_.]+$"
    },
    "hidden": {
      "type": "boolean"
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "within_days": {
          "type": "integer",
          "minimum": 1
        },
        "flag": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
